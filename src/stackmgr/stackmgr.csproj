<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>stackmgr</ToolCommandName>
        <PackageOutputPath>./bin/nupkg</PackageOutputPath>
        <Title>Stack Deployment Manager</Title>
        <Authors>Talaryon Labs</Authors>
        <PackageProjectUrl>https://github.com/talaryonlabs/stackmgr</PackageProjectUrl>
        <RepositoryUrl>https://github.com/talaryonlabs/stackmgr</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <Description>Management CLI for Deployment Stack</Description>
        <PackageLicenseUrl>https://github.com/talaryonlabs/stackmgr/blob/main/LICENSE</PackageLicenseUrl>
        <PackageId>talaryonlabs.stackmgr</PackageId>
        <Version>1.0.0</Version>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.2" />
      <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.2" />
      <PackageReference Include="System.CommandLine" Version="2.0.2" />
      <PackageReference Include="YamlDotNet" Version="16.3.0" />
    </ItemGroup>

    <ItemGroup>
      <Reference Include="Talaryon.Toolbox">
        <HintPath>..\..\libs\Talaryon.Toolbox.dll</HintPath>
      </Reference>
    </ItemGroup>

</Project>
