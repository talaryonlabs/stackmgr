<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>stackmgr</ToolCommandName>
        <PackageOutputPath>./bin/nupkg</PackageOutputPath>
        <Title>Stack Deployment Manager</Title>
        <Authors>Talaryon Labs</Authors>
        <PackageProjectUrl>https://github.com/talaryonlabs/stackmgr</PackageProjectUrl>
        <RepositoryUrl>https://github.com/talaryonlabs/stackmgr</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <Description>Management CLI for Deployment Stack</Description>
        <PackageLicenseUrl>https://github.com/talaryonlabs/stackmgr/blob/main/LICENSE</PackageLicenseUrl>
        <PackageId>Talaryon.StackManager</PackageId>
        <RootNamespace>Talaryon.StackManager</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="GitVersion.MsBuild" Version="6.7.0" PrivateAssets="all" />
      <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="10.0.8" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.8" />
      <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
      <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.8" />
      <PackageReference Include="System.CommandLine" Version="3.0.0-preview.4.26230.115" />
      <PackageReference Include="Talaryon.Toolbox" Version="1.3.7" />
      <PackageReference Include="Talaryon.Toolbox.Services" Version="1.0.1" />
      <PackageReference Include="YamlDotNet" Version="18.0.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\StackManager.Shared\StackManager.Shared.csproj" />
    </ItemGroup>

</Project>
